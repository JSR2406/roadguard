# Copy to .env only on the deployment host. Never commit actual credentials.
# Create the ignored secrets directory first, then generate credentials with:
#   mkdir -p secrets
#   npm run provision -- --output ./secrets/roadguard-auth.json
# Relative paths keep this template portable across clean machines.
ROADGUARD_AUTH_FILE=./secrets/roadguard-auth.json
ROADGUARD_ORIGIN=http://localhost:8080
ROADGUARD_PORT=8080
